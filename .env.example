# TenderMed Intelligence – environment variables
# Copy to .env.local for local development. Never commit real values.

# --- Public site ------------------------------------------------------------
# Canonical origin of the production site, e.g. https://www.example.si
# Leave empty until a real domain exists: canonical URLs, the sitemap and
# indexing stay disabled while it is empty.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (required for working inquiry forms) --------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Server-only secret key (sb_secret_...). Never expose it via NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
# Legacy alternative for projects that still use JWT keys. Use only if no
# secret key is available; SUPABASE_SECRET_KEY takes precedence.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---------------------------------------------------------------
# Key for pseudonymizing IP/e-mail in rate limiting. Defaults to the Supabase
# secret key when empty; set it to rotate independently.
# RATE_LIMIT_HASH_SECRET=

# Additional origins allowed to POST to the form endpoints (comma-separated),
# e.g. a custom preview domain. The request's own host is always allowed.
# FORM_ALLOWED_ORIGINS=

# Optional Cloudflare Turnstile anti-bot check (both values required to enable).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Pin the demo reference date (YYYY-MM-DD) for screenshots or reproducible tests.
# DEMO_REFERENCE_DATE=

# Optional future browser/Auth integration (not used in this release):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
